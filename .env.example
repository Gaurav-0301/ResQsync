# ResQsync Environment Configuration Example

# Next.js Application Settings
NEXT_PUBLIC_APP_NAME=ResQsync
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Maps API Key (Optional for K-Maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Python Backend / ESP32 Settings
BACKEND_PORT=8000
SERIAL_PORT=COM3
BAUD_RATE=115200

# Emergency Alert SMTP Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
RECIPIENT_EMAIL=alert_destination@gmail.com
